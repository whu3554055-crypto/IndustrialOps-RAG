# 复制为 .env — 勿提交密钥

IOR_PROFILE=dev-single-node

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ior
POSTGRES_PASSWORD=ior_dev
POSTGRES_DB=industrial_ops
DATABASE_URL=postgresql+asyncpg://ior:ior_dev@localhost:5432/industrial_ops

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=industrial_ops_chunks

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=industrial_ops_bm25

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio_dev
MINIO_BUCKET=ior-models

# LLM — vLLM OpenAI-compatible
LLM_ACTIVE_BACKEND=vllm
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
TENSORRT_LLM_BASE_URL=http://localhost:8001/v1

# 可选 API 对照（招聘 GPT-4 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Embedding / Rerank
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
