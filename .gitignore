# ── Data & models (IndustrialOps-RAG) ──
# 原始语料与解析产物（保留目录占位）
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
# M7 真实语料目录（仅保留 README）
data/corpus/business/**
!data/corpus/business/README.md
# 评测集：保留 example 模板，忽略本地 golden
data/eval/golden.jsonl
data/eval/*.jsonl
!data/eval/golden.jsonl.example
!data/eval/golden_m7.jsonl.example
!data/eval/m2_golden.jsonl.example
!data/eval/.gitkeep

models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.engine
*.trt

# HuggingFace / 训练缓存（若设 HF_HOME 于项目内）
.cache/
huggingface/

